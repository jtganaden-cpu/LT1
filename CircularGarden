import math # To make math functions work

radius = float(input("Enter radius in meters: ")) # Input Radius

area = math.pi * math.pow(radius, 2) # Line 5 - 9: Proccesing
circumference = 2 * math.pi * radius
square_root = math.sqrt(area)
rounded_down = math.floor(area)
rounded_up = math.ceil(area)

print(f"Area of the garden: {area:.2f} square meters") # Line 11 - 15: Output
print(f"Circumference of the garden: {circumference:.2f} square meters")
print(f"Square Root of Area: {square_root:.2f}")
print(f"Area Rounded Down: {rounded_down} square meters")
print(f"Area Rounded Up: {rounded_up} square meters")
